{
  "name": "@fungi.computer/almanac",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Target-agnostic durable schedule core: cron cadence, occurrence identity, missed-tick and retry policy",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test examples scripts --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src test examples scripts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/almanac-pack && pnpm pack --pack-destination ../../.botanical/almanac-pack",
    "smoke": "node examples/next-occurrence.mjs",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "stranger:browser": "node test/stranger/browser.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "effect": "4.0.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "license": "MIT",
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "docs/api",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/almanac.git"
  }
}
